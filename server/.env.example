# Copy to .env and fill in. Never commit the real .env.

# Your Anthropic API key (https://console.anthropic.com) - powers the fact-checks.
ANTHROPIC_API_KEY=

# 32 random bytes, base64. Encrypts health data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: if it's lost, stored health profiles can't be read.
HEALTH_DATA_KEY=

PORT=4000
DATABASE_PATH=./data/factfit.db

# dev = choosing a plan in the app unlocks it for free (testing only).
# revenuecat = real App Store / Google Play subscriptions.
BILLING_MODE=dev
REVENUECAT_WEBHOOK_SECRET=

# Set to 1 to try the app without an API key (fake, clearly-labelled results).
DEMO_MODE=0

# Browser origins allowed to call the API (only needed for the web preview).
# CORS_ORIGINS=http://localhost:8081
